# Keep every text file LF in the repository so the bot behaves identically on
# Windows, macOS and the Linux GitHub Actions runner.
* text=auto eol=lf

# Binary assets must never be converted
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# Tell Git how to handle automated bot updates without crashing
logs/posting.log merge=union
state/daily_count.json merge=ours
